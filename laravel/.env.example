APP_NAME="SMS Payment Gateway"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# Shared secret between Termux listener and Laravel.
# Must match the value in termux/config.json → laravel.api_token
API_TOKEN=your-secret-api-token-here

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# For SQLite, set DB_DATABASE to an absolute path, e.g.:
# DB_DATABASE=/absolute/path/to/database.sqlite
# Leave blank to use the default storage/database.sqlite location
DB_DATABASE=

# MySQL example (uncomment to use)
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=sms_gateway
# DB_USERNAME=root
# DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
